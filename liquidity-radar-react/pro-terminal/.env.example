# All optional. The app runs fully keyless against exchange public APIs.
# Keys must ONLY be used by a server-side proxy; never expose them in the browser bundle.
COINGECKO_DEMO_KEY=
# Radar AI chat. Without it the assistant falls back to the built-in
# rule-based analyst, which still answers from live terminal data.
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
FRED_API_KEY=
