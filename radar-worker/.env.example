# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (URI form). Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: Supabase → Database settings → SSL → download certificate, then
# point here to have the server's identity verified (the link is TLS either way).
# DATABASE_CA_FILE=./prod-ca-2021.crt

# Symbols to collect (Binance spot).
SYMBOLS=BTCUSDT,PAXGUSDT

# How far back the first run backfills. BTC is ~1000 REST pages per ~4 hours.
BACKFILL_DAYS=14

# Pause between REST pages per backfill, ms. 350 is ~3 pages/s — well inside
# Binance's public limits.
PACE_MS=350

# ---- Trading bot (npm run bot) --------------------------------------------
# Binance Futures TESTNET keys: https://testnet.binancefuture.com → API Key.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Default is the testnet. Mainnet additionally requires ALLOW_MAINNET=yes.
# FUTURES_BASE=https://demo-fapi.binance.com

BOT_SYMBOLS=BTCUSDT,PAXGUSDT
# gated  = trade only a model whose walk-forward results pass the gate (default)
# explore = trade the model's best idea even without a proven edge — testnet
#           only makes sense here; it gathers real trade records to learn from
BOT_MODE=gated

# Hard limits (fractions). No model output can override these.
RISK_PER_TRADE=0.005
MAX_NOTIONAL_X=2
LEVERAGE=3
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.15
