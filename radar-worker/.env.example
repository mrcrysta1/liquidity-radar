# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (URI form). Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: Supabase → Database settings → SSL → download certificate, then
# point here to have the server's identity verified (the link is TLS either way).
# DATABASE_CA_FILE=./prod-ca-2021.crt

# Symbols to collect (Binance spot).
SYMBOLS=BTCUSDT,PAXGUSDT

# How far back the first run backfills. BTC is ~1000 REST pages per ~4 hours.
BACKFILL_DAYS=14

# Pause between REST pages per backfill, ms. 350 is ~3 pages/s — well inside
# Binance's public limits.
PACE_MS=350

# ---- Trading bot (npm run bot) --------------------------------------------
# Binance Futures testnet keys (practice money). Binance moved the futures testnet
# to Demo Trading: log in at binance.com → Demo Trading → API Management. Keys from
# the older testnet.binancefuture.com portal also work against the default URL.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# TESTNET ONLY. Must be exactly one of these, or the bot refuses to start
# (there is no mainnet override):
#   https://demo-fapi.binance.com        (default)
#   https://testnet.binancefuture.com    (reachable from US hosts, e.g. GitHub Actions)
# FUTURES_BASE=https://demo-fapi.binance.com

BOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XAUUSDT
# Smallest margin per trade in USDT (raises a too-small size; at most 2x the normal risk). 0 = off.
BOT_MIN_MARGIN=100
# Run for N minutes, then exit cleanly (for hosted runners that hand over). Unset = forever.
# BOT_RUN_MINUTES=340
# gated  = trade only a model whose walk-forward results pass the gate (default)
# explore = trade the model's best idea even without a proven edge — testnet
#           only makes sense here; it gathers real trade records to learn from
# hybrid  = real orders only where the gate passes, the symbol is in
#           BOT_REAL_SYMBOLS and the portfolio heat cap allows; every other
#           signal becomes a shadow trade
BOT_MODE=gated
# ml    = the model places the real orders, as BOT_MODE says (default)
# trend = research strategy F1 places them (4h breakout, long only, 3 ATR stop
#         trailed at 4 ATR, no target; sql/007_bot_trend.sql); the model only
#         shadow trades. Heat caps and BOT_REAL_SYMBOLS still apply.
# BOT_STRATEGY=ml
# Hybrid and trend: symbols allowed real orders (default: all of BOT_SYMBOLS), and the
# portfolio heat caps: open risk per direction and in total, fractions of equity.
# BOT_REAL_SYMBOLS=BTCUSDT,XAUUSDT
# BOT_MAX_SIDE_RISK=0.015
# BOT_MAX_TOTAL_RISK=0.02

# Hard limits (fractions). No model output can override these.
RISK_PER_TRADE=0.005
MAX_NOTIONAL_X=2
LEVERAGE=3
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.15

# Bracket in ATRs of the bar interval, and the time exit in bars. Every trade and
# every training label uses it. (Default 1.5 / 3 / 12.)
# BOT_SL_ATR=1.5
# BOT_TP_ATR=3
# BOT_HORIZON=12

# Setup rules, all checked before any order (src/bot/setup.ts). Model EV must
# also be > 0 (and above BOT_MIN_EV if that is set higher).
# Reward:risk after estimated fees + slippage; round-trip cost (stop-exit case)
# in R; cooldown on a symbol after a stop-out; positions open at once and real
# trades per UTC day, across all symbols.
BOT_MIN_RR=1.5
BOT_MAX_COST_R=0.15
BOT_COOLDOWN_MIN=30
BOT_MAX_OPEN=4
BOT_MAX_TRADES_DAY=120

# Learning. Setups rejected only by the EV / gate verdict become shadow trades
# (resolved virtually, no orders). A challenger model is trained every
# BOT_LEARN_EVERY_MIN minutes or after BOT_LEARN_EVERY_TRADES closed real+shadow trades.
BOT_SHADOW=1
# Shadow trades open at once per symbol (default 1; hybrid: BOT_HORIZON + 1, i.e. every signal).
BOT_SHADOW_MAX_OPEN=1
BOT_LEARN_EVERY_MIN=60
BOT_LEARN_EVERY_TRADES=20
